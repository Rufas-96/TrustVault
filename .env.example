# Copy to .env (or set in your host's dashboard). Never commit real values.
NODE_ENV=production
PORT=3000
# 64 hex chars (32 bytes) or any random string of 32+ characters. Generate with: npm run keys
FILE_ENCRYPTION_KEY=
AUDIT_HMAC_KEY=
# Where the SQLite database and encrypted files live
DATA_DIR=./data
# Set to false to skip creating demo users/documents on an empty database
SEED_DEMO=true
